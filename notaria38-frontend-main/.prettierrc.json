{
    "semi": true,
    "singleQuote": true,
    "printWidth": 90,
    "tabWidth": 4,
    "useTabs": false,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "endOfLine": "lf",
    "quoteProps": "as-needed",
    "jsxSingleQuote": true,
    "overrides": [
        {
            "files": ["*.jsx", "*.tsx"],
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
